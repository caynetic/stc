{
  "name": "serve-the-cays-cloudflare",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "css:build": "tailwindcss -i ./styles/tailwind.css -o ./public/assets/tailwind.css --minify",
    "css:watch": "tailwindcss -i ./styles/tailwind.css -o ./public/assets/tailwind.css --watch",
    "predev": "npm run css:build",
    "check": "tsc --noEmit",
    "build:production": "wrangler deploy --dry-run --config wrangler.jsonc --env production --outdir .wrangler/dry-run-production",
    "test": "vitest run && node --test test/static-contract.mjs",
    "public:check": "node ops/check-public-repo.mjs",
    "config:verify": "node ops/verify-production-config.mjs",
    "verify": "npm run css:build && npm run check && npm run build:production && npm test && npm run public:check",
    "dev": "wrangler dev --config wrangler.local.jsonc --local --persist-to .wrangler/state",
    "db:migrate:local": "wrangler d1 migrations apply DB --config wrangler.local.jsonc --local --persist-to .wrangler/state",
    "db:seed:local": "wrangler d1 execute DB --config wrangler.local.jsonc --local --persist-to .wrangler/state --file=ops/seed-development.sql",
    "deploy": "node -e \"console.error('Use ops/production-runbook.md; direct npm deployment is disabled.'); process.exit(1)\""
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.21.3",
    "@cloudflare/workers-types": "^5.20260814.1",
    "@tailwindcss/cli": "4.3.3",
    "@types/node": "^24.0.0",
    "tailwindcss": "4.3.3",
    "typescript": "^7.0.2",
    "vitest": "^4.1.0",
    "wrangler": "^4.123.0"
  }
}
